          "stringUnit" : {
            "state" : "translated",
            "value" : "સળંગ રમવાનું લક્ષ્ય દરરોજ 5 મિનિટથી શરૂ થાય છે. ફક્ત સક્રિય રમતનો સમય ગણાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יעד הרצף מתחיל ב־5 דקות ביום. רק זמן משחק פעיל נחשב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार खेलने का लक्ष्य रोज़ 5 मिनट से शुरू होता है। केवल खेलने का समय गिना जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sorozat célja napi 5 perccel indul. Csak az aktív játékidő számít."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tosaíonn sprioc na sraithe ag 5 nóiméad sa lá. Ní áirítear ach am imeartha gníomhach."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raðmarkmiðið byrjar á 5 mínútum á dag. Aðeins virkur leiktími telst."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target rentetan dimulai dari 5 menit per hari. Hanya waktu bermain aktif yang dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’obiettivo della serie parte da 5 minuti al giorno. Conta solo il tempo di gioco attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "れんぞく目標は1日5分から。実際に遊んだ時間だけ数えます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸತತ ಆಟದ ಗುರಿ ದಿನಕ್ಕೆ 5 ನಿಮಿಷದಿಂದ ಆರಂಭವಾಗುತ್ತದೆ. ಸಕ್ರಿಯವಾಗಿ ಆಡಿದ ಸಮಯ ಮಾತ್ರ ಲೆಕ್ಕಕ್ಕೆ ಸೇರುತ್ತದೆ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Күндер тізбегінің мақсаты күніне 5 минуттан басталады. Тек белсенді ойын уақыты есептеледі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គោលដៅលេងជាប់គ្នាចាប់ផ្តើមពី 5 នាទីក្នុងមួយថ្ងៃ។ រាប់តែពេលលេងសកម្មប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연속 목표는 하루 5분부터 시작해요. 실제로 플레이한 시간만 계산돼요."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj niza počinje s 5 minuta dnevno. Broji se samo aktivno vrijeme igranja."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເປົ້າໝາຍຕໍ່ເນື່ອງເລີ່ມທີ່ 5 ນາທີຕໍ່ມື້. ນັບສະເພາະເວລາທີ່ຫຼິ້ນຈິງ."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sērijas mērķis sākas ar 5 minūtēm dienā. Skaita tikai aktīvo spēles laiku."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienos serijos tikslas prasideda nuo 5 minučių per dieną. Skaičiuojamas tik aktyvus žaidimo laikas."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целта за низа почнува со 5 минути дневно. Се брои само активното играње."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasaran rentetan bermula pada 5 minit sehari. Hanya masa bermain aktif dikira."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തുടർച്ചാ ലക്ഷ്യം ദിവസം 5 മിനിറ്റിൽ തുടങ്ങും. സജീവമായി കളിച്ച സമയം മാത്രം എണ്ണും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सलग खेळण्याचे ध्येय दररोज 5 मिनिटांपासून सुरू होते. फक्त प्रत्यक्ष खेळलेला वेळ मोजला जातो."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дарааллын зорилго өдөрт 5 минутаас эхэлнэ. Зөвхөн идэвхтэй тоглосон хугацааг тооцно."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार खेल्ने लक्ष्य दिनको ५ मिनेटबाट सुरु हुन्छ। सक्रिय खेल समय मात्र गनिन्छ।"
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekkemålet starter på 5 minutter per dag. Bare aktiv spilletid teller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серія починається з 5 хвилин на день. Рахується лише активний час гри."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଲଗାତାର ଖେଳ ଲକ୍ଷ୍ୟ ଦିନକୁ 5 ମିନିଟ୍‌ରୁ ଆରମ୍ଭ ହୁଏ। କେବଳ ସକ୍ରିୟ ଖେଳ ସମୟ ଗଣାଯାଏ।"
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئۇدا داۋاملاشتۇرۇش نىشانى كۈنىگە 5 مىنۇتتىن باشلىنىدۇ. پەقەت ئاكتىپ ئوينىغان ۋاقىت ھېسابلىنىدۇ."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketma-ketlik maqsadi kuniga 5 daqiqadan boshlanadi. Faqat faol o‘yin vaqti hisoblanadi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدف زنجیره از روزی ۵ دقیقه شروع می‌شود. فقط زمان بازی فعال حساب می‌شود."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel serii zaczyna się od 5 minut dziennie. Liczy się tylko aktywna gra."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meta da sequência começa nos 5 minutos por dia. Só conta o tempo de jogo ativo."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਲਗਾਤਾਰ ਖੇਡਣ ਦਾ ਟੀਚਾ ਹਰ ਰੋਜ਼ 5 ਮਿੰਟ ਤੋਂ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ। ਸਿਰਫ਼ ਸਰਗਰਮ ਖੇਡ ਸਮਾਂ ਗਿਣਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seria începe cu 5 minute pe zi. Contează doar timpul în care te joci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель серии начинается с 5 минут в день. Учитывается только активное время игры."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj niza počinje sa 5 minuta dnevno. Računa se samo aktivno vreme igranja."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අඛණ්ඩ ඉලක්කය දිනකට මිනිත්තු 5කින් පටන් ගනී. ක්‍රියාකාරී ක්‍රීඩා කාලය පමණක් ගණන් වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieľ série začína na 5 minútach denne. Počíta sa iba aktívny čas hrania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj niza se začne pri 5 minutah na dan. Šteje le čas aktivnega igranja."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La racha empieza con 5 minutos al día. Solo cuenta el tiempo de juego activo."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengo la mfululizo huanza na dakika 5 kwa siku. Muda wa kucheza kwa bidii pekee ndio huhesabiwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர் இலக்கு நாளுக்கு 5 நிமிடங்களில் தொடங்கும். விளையாடிய நேரம் மட்டும் கணக்காகும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వరుస లక్ష్యం రోజుకు 5 నిమిషాల నుంచి మొదలవుతుంది. చురుకుగా ఆడిన సమయం మాత్రమే లెక్కలోకి వస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป้าหมายต่อเนื่องเริ่มที่วันละ 5 นาที นับเฉพาะเวลาเล่นจริง"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "བསྟུད་མར་རྩེ་བའི་དམིགས་ཡུལ་ཉིན་རེར་སྐར་མ་5 ནས་འགོ་འཛུགས། དངོས་སུ་རྩེ་བའི་དུས་ཚོད་ཁོ་ན་བརྩི།"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cíl série začíná na 5 minutách denně. Počítá se jen aktivní hraní."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seri hedefi günde 5 dakikayla başlar. Yalnızca aktif oyun süresi sayılır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسلسل کھیل کا ہدف روز 5 منٹ سے شروع ہوتا ہے۔ صرف کھیلنے کا اصل وقت گنا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuỗi ngày bắt đầu với mục tiêu 5 phút mỗi ngày. Chỉ thời gian chơi thực tế được tính."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae nod y gyfres yn dechrau ar 5 munud y dydd. Dim ond amser chwarae gweithredol sy'n cyfrif."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мэта серыі пачынаецца з 5 хвілін штодня. Залічваецца толькі час актыўнай гульні."
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgomo wokulandelana uqala ngemizuzu emi-5 ngosuku. Kubalwa kuphela isikhathi sokudlala ngempela."

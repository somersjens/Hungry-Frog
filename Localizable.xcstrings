    "settings.goalInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The streak goal starts at 5 minutes per day. Only active playtime counts."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het streakdoel begint bij 5 minuten per dag. Alleen actieve speeltijd telt mee."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die reeksdoel begin by 5 minute per dag. Net aktiewe speeltyd tel."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objektivi i serisë nis me 5 minuta në ditë. Numërohet vetëm koha aktive e lojës."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተከታታይ ቀን ግብ በቀን ከ5 ደቂቃ ይጀምራል። የሚቆጠረው ንቁ የጨዋታ ጊዜ ብቻ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ هدف الاستمرار بـ5 دقائق يوميًا. يُحسب وقت اللعب الفعلي فقط."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շարքի նպատակը սկսվում է օրական 5 րոպեից։ Հաշվվում է միայն ակտիվ խաղաժամանակը։"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একেৰাহে খেলাৰ লক্ষ্য দিনে ৫ মিনিটৰ পৰা আৰম্ভ। কেৱল সক্ৰিয় খেলৰ সময় গণনা হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ardıcıl gün hədəfi gündə 5 dəqiqədən başlayır. Yalnız aktiv oyun vaxtı sayılır."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segidaren helburua eguneko 5 minututan hasten da. Jolas-denbora aktiboa bakarrik zenbatzen da."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধারাবাহিকতার লক্ষ্য দিনে ৫ মিনিট থেকে শুরু হয়। শুধু সক্রিয় খেলার সময় গোনা হয়।"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်တိုက်ပန်းတိုင်က တစ်နေ့ ၅ မိနစ်ကနေ စတယ်။ တကယ်ကစားတဲ့အချိန်ပဲ ရေတွက်မယ်။"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj niza počinje s 5 minuta dnevno. Računa se samo aktivno vrijeme igranja."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целта за поредица започва от 5 минути на ден. Брои се само активното време за игра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’objectiu de ratxa comença amb 5 minuts al dia. Només compta el temps de joc actiu."
          }
        },
        "zh" : {
          "stringUnit" : {

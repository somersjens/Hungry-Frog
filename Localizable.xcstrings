        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چھوٹے کھلاڑیوں کی حفاظت کے لیے خریداری جاری رکھنے سے پہلے کسی بالغ کو یہ جانچ مکمل کرنا ہوگی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để bảo vệ người chơi nhỏ tuổi, người lớn phải hoàn thành bước kiểm tra này trước khi tiếp tục mua."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I amddiffyn chwaraewyr ifanc, rhaid i oedolyn gwblhau'r gwiriad hwn cyn parhau at y pryniant."

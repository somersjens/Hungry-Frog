    "parentGate.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To protect young players, an adult must complete this check before continuing to the purchase."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om jonge spelers te beschermen, moet een volwassene deze controle voltooien voordat de aankoop kan worden voortgezet."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om jong spelers te beskerm, moet ’n volwassene dié toets voltooi voordat die aankoop kan voortgaan."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Për të mbrojtur lojtarët e vegjël, një i rritur duhet ta kryejë këtë kontroll para blerjes."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ትንንሽ ተጫዋቾችን ለመጠበቅ፣ ወደ ግዢው ከመቀጠል በፊት አንድ አዋቂ ይህን ማረጋገጫ ማጠናቀቅ አለበት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحماية اللاعبين الصغار، يجب أن يُكمل شخص بالغ هذا التحقق قبل متابعة الشراء."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փոքրիկ խաղացողներին պաշտպանելու համար մեծահասակը պետք է անցնի այս ստուգումը՝ գնումը շարունակելուց առաջ։"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সৰু খেলুৱৈক সুৰক্ষিত ৰাখিবলৈ ক্ৰয়ৰ আগতে এজন ডাঙৰে এই পৰীক্ষা সম্পূৰ্ণ কৰিব লাগিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balaca oyunçuları qorumaq üçün alışa davam etməzdən əvvəl bir böyük bu yoxlamanı tamamlamalıdır."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokalari gazteak babesteko, heldu batek egiaztapen hau osatu behar du erosketarekin jarraitu aurretik."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছোট খেলোয়াড়দের সুরক্ষায়, কেনাকাটা চালানোর আগে একজন প্রাপ্তবয়স্ককে এই যাচাই শেষ করতে হবে।"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကလေးကစားသမားတွေကို ကာကွယ်ဖို့ ဝယ်ယူမှုမဆက်ခင် လူကြီးတစ်ယောက်က ဒီစစ်ဆေးမှုကို ပြီးအောင်လုပ်ရမယ်။"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radi zaštite mladih igrača, odrasla osoba mora završiti ovu provjeru prije kupovine."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да защитим малките играчи, възрастен трябва да премине тази проверка преди покупката."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per protegir els jugadors més petits, un adult ha de completar aquesta comprovació abans de continuar amb la compra."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了保护小玩家，继续购买前需要一位成年人完成验证。"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at beskytte unge spillere skal en voksen gennemføre dette tjek, før købet kan fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Schutz junger Spieler muss ein Erwachsener diese Prüfung abschließen, bevor der Kauf fortgesetzt werden kann."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noorte mängijate kaitsmiseks peab täiskasvanu enne ostu jätkamist selle kontrolli läbima."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyri at verja ung spælandi má ein vaksin gera hesa kanningina, áðrenn keypið kann halda fram."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuorten pelaajien suojelemiseksi aikuisen on tehtävä tämä tarkistus ennen ostoksen jatkamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour protéger les jeunes joueurs, un adulte doit terminer ce contrôle avant de poursuivre l’achat."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para protexer os xogadores máis novos, un adulto debe completar esta comprobación antes de continuar coa compra."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პატარა მოთამაშეების დასაცავად, ყიდვის გაგრძელებამდე ეს შემოწმება უფროსმა უნდა გაიაროს."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για την προστασία των μικρών παικτών, ένας ενήλικας πρέπει να ολοκληρώσει αυτόν τον έλεγχο πριν από την αγορά."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નાના ખેલાડીઓની સુરક્ષા માટે ખરીદી આગળ વધે તે પહેલાં કોઈ મોટા વ્યક્તિએ આ તપાસ પૂરી કરવી જરૂરી છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להגן על שחקנים צעירים, מבוגר חייב להשלים את הבדיקה לפני המשך הרכישה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटे खिलाड़ियों की सुरक्षा के लिए, खरीदारी से पहले किसी बड़े को यह जाँच पूरी करनी होगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiatal játékosok védelmében egy felnőttnek el kell végeznie ezt az ellenőrzést a vásárlás előtt."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chun imreoirí óga a chosaint, caithfidh duine fásta an tseiceáil seo a dhéanamh sula leanfar leis an gceannach."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að vernda unga leikmenn þarf fullorðinn að ljúka þessari athugun áður en haldið er áfram í kaup."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk melindungi pemain cilik, orang dewasa harus menyelesaikan pemeriksaan ini sebelum melanjutkan pembelian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per proteggere i piccoli giocatori, un adulto deve completare questo controllo prima di continuare con l’acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さなお子さまを守るため、購入に進む前に大人の方がこの確認を行ってください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚಿಕ್ಕ ಆಟಗಾರರನ್ನು ರಕ್ಷಿಸಲು, ಖರೀದಿಗೆ ಮುಂದುವರಿಯುವ ಮೊದಲು ವಯಸ್ಕರು ಈ ಪರಿಶೀಲನೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಬೇಕು."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кішкентай ойыншыларды қорғау үшін сатып алуды жалғастырмас бұрын ересек адам осы тексеруден өтуі керек."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដើម្បីការពារអ្នកលេងវ័យក្មេង មនុស្សពេញវ័យត្រូវបំពេញការត្រួតពិនិត្យនេះ មុនបន្តទៅការទិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어린 사용자를 보호하기 위해 구매를 계속하기 전에 어른이 이 확인을 완료해야 해요."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radi zaštite mladih igrača odrasla osoba mora dovršiti ovu provjeru prije nastavka kupnje."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເພື່ອປົກປ້ອງຜູ້ຫຼິ້ນເດັກນ້ອຍ ຜູ້ໃຫຍ່ຕ້ອງກວດສອບນີ້ໃຫ້ສຳເລັດກ່ອນຊື້."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai aizsargātu mazos spēlētājus, pirms pirkuma turpināšanas pieaugušajam jāizpilda šī pārbaude."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad apsaugotume mažuosius žaidėjus, prieš tęsiant pirkimą šį patikrinimą turi atlikti suaugusysis."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да ги заштитиме младите играчи, возрасен мора да ја заврши оваа проверка пред купувањето."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk melindungi pemain muda, orang dewasa mesti selesaikan semakan ini sebelum meneruskan pembelian."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചെറിയ കളിക്കാരെ സംരക്ഷിക്കാൻ, വാങ്ങലിലേക്ക് പോകുന്നതിന് മുമ്പ് ഒരു മുതിർന്നയാൾ ഈ പരിശോധന പൂർത്തിയാക്കണം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लहान खेळाडूंच्या सुरक्षेसाठी, खरेदी सुरू ठेवण्यापूर्वी एखाद्या मोठ्या व्यक्तीने ही तपासणी पूर्ण करावी."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бяцхан тоглогчдыг хамгаалахын тулд худалдан авалтаас өмнө насанд хүрсэн хүн энэ шалгалтыг давах ёстой."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साना खेलाडीको सुरक्षाका लागि, खरिदमा जानुअघि एक वयस्कले यो जाँच पूरा गर्नुपर्छ।"
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å beskytte unge spillere må en voksen fullføre denne kontrollen før kjøpet kan fortsette."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб захистити маленьких гравців, дорослий має пройти цю перевірку перед покупкою."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଛୋଟ ଖେଳାଳିମାନଙ୍କୁ ସୁରକ୍ଷିତ ରଖିବା ପାଇଁ, କିଣାକୁ ଆଗେଇ ନେବା ପୂର୍ବରୁ ଜଣେ ବୟସ୍କ ଏହି ଯାଞ୍ଚ ପୂରଣ କରିବା ଆବଶ୍ୟକ।"
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كىچىك ئوينىغۇچىلارنى قوغداش ئۈچۈن، سېتىۋېلىشنى داۋاملاشتۇرۇشتىن بۇرۇن چوڭ كىشى بۇ تەكشۈرۈشنى تاماملىشى كېرەك."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yosh o‘yinchilarni himoya qilish uchun xaridni davom ettirishdan oldin kattalar bu tekshiruvdan o‘tishi kerak."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای محافظت از بازیکنان خردسال، یک بزرگسال باید پیش از ادامهٔ خرید این بررسی را انجام دهد."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby chronić młodych graczy, przed zakupem osoba dorosła musi przejść tę kontrolę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger os jogadores mais novos, um adulto tem de concluir esta verificação antes de continuar para a compra."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨੰਨੇ ਖਿਡਾਰੀਆਂ ਦੀ ਸੁਰੱਖਿਆ ਲਈ, ਖਰੀਦ ਅੱਗੇ ਵਧਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਕਿਸੇ ਵੱਡੇ ਨੂੰ ਇਹ ਜਾਂਚ ਪੂਰੀ ਕਰਨੀ ਪਵੇਗੀ।"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a proteja copiii, un adult trebuie să treacă această verificare înainte de cumpărare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы защитить юных игроков, взрослый должен пройти эту проверку перед покупкой."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da bismo zaštitili mlade igrače, odrasla osoba mora da završi ovu proveru pre kupovine."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කුඩා ක්‍රීඩකයන් ආරක්ෂා කිරීමට, මිලදී ගැනීමට පෙර වැඩිහිටියෙකු මේ පරීක්ෂාව සම්පූර්ණ කළ යුතුය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ochranu malých hráčov musí dospelý pred pokračovaním k nákupu dokončiť túto kontrolu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za zaščito mladih igralcev mora odrasla oseba pred nadaljevanjem nakupa opraviti to preverjanje."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger a los jugadores más pequeños, un adulto debe completar esta comprobación antes de continuar con la compra."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili kuwalinda wachezaji wadogo, mtu mzima lazima akamilishe ukaguzi huu kabla ya kuendelea na ununuzi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இளம் வீரர்களைப் பாதுகாக்க, வாங்குவதற்கு முன் ஒரு பெரியவர் இந்தச் சரிபார்ப்பை முடிக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చిన్నారులను రక్షించడానికి, కొనుగోలుకు వెళ్లే ముందు ఒక పెద్దవారు ఈ తనిఖీని పూర్తి చేయాలి."

        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อปกป้องผู้เล่นตัวน้อย ผู้ใหญ่ต้องผ่านการตรวจสอบนี้ก่อนซื้อ"

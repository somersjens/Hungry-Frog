          "stringUnit" : {
            "state" : "translated",
            "value" : "නිහඬව සෙල්ලම් කරන්න ශබ්දය අක්‍රිය කරන්න. ක්‍රීඩාව ඒ විදිහටම වැඩ කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypni zvuk a hraj potichu. Hra funguje úplne rovnako."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izklopi zvok za tiho igranje. Igra ostane povsem enaka."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva el sonido para jugar en silencio. El juego funciona igual."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zima sauti ili ucheze kimya. Mchezo utaendelea vilevile."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அமைதியாக விளையாட ஒலியை அணைக்கவும். விளையாட்டு அதேபோல இயங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిశ్శబ్దంగా ఆడాలంటే శబ్దాన్ని ఆఫ్ చేయి. ఆట మాత్రం అలాగే ఉంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดเสียงเพื่อเล่นเงียบ ๆ เกมยังเล่นเหมือนเดิม"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཁུ་སིམ་པོར་རྩེ་བར་སྒྲ་ཁ་རྒྱོབ། རྩེད་མོ་འདྲ་མཚུངས་སུ་འགྲོ།"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypni zvuk a hraj potichu. Hra funguje úplně stejně."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiz oynamak için sesi kapat. Oyun aynı şekilde devam eder."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموشی سے کھیلنے کے لیے آواز بند کریں۔ کھیل بالکل ویسا ہی چلے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt âm thanh để chơi yên lặng. Trò chơi vẫn hoạt động như cũ."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffodd y sain i chwarae’n dawel. Mae’r gêm yn gweithio yn union yr un fath."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключы гук, каб гуляць ціха. Гульня будзе працаваць гэтак жа."
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vala umsindo ukuze udlale buthule. Umdlalo usebenza ngendlela efanayo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av ljudet för att spela tyst. Spelet fungerar precis likadant."
          }
        }
      }
    },

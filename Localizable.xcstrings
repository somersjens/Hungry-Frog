    "settings.characterInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every animal brings its own color theme to the whole game."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk dier geeft het hele spel zijn eigen kleurenthema."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dier gee die hele spel sy eie kleurtema."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çdo kafshë i jep gjithë lojës temën e vet me ngjyra."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያንዳንዱ እንስሳ ለጨዋታው በሙሉ የራሱን የቀለም ገጽታ ያመጣል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنح كل حيوان اللعبة كلها ألوانه الخاصة."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Յուրաքանչյուր կենդանի ամբողջ խաղին տալիս է իր գունային ձևավորումը։"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্ৰতিটো জন্তুৱে গোটেই খেললৈ নিজৰ ৰঙৰ থিম আনে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər heyvan bütün oyuna öz rəng mövzusunu gətirir."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animalia bakoitzak bere kolore-gaia ematen dio joko osoari."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি প্রাণী পুরো খেলায় নিজের রঙের থিম আনে।"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "တိရစ္ဆာန်တစ်ကောင်စီက ဂိမ်းတစ်ခုလုံးကို သူ့အရောင်ပုံစံနဲ့ ပြောင်းပေးတယ်။"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka životinja daje cijeloj igri svoju temu boja."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяко животно дава своя цветна тема на цялата игра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada animal dona al joc el seu propi tema de colors."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种动物都会给整个游戏带来自己的配色。"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert dyr giver hele spillet sit eget farvetema."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Tier gibt dem ganzen Spiel sein eigenes Farbthema."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga loom annab kogu mängule oma värviteema."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",

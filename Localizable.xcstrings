    "notif.comeback.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your animals are waiting. Jump back in and keep collecting flies!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dieren wachten op je. Spring weer verder en verzamel meer vliegen!"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jou diere wag. Kom terug om te speel en hou aan om vlieë in te samel!"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kafshët tuaja janë duke pritur. Kthehuni për të luajtur dhe vazhdoni të mblidhni miza!"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንስሳትዎ እየጠበቁ ናቸው. ለመጫወት ይመለሱ እና ዝንቦችን መሰብሰብዎን ይቀጥሉ!"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيواناتك تنتظر. عد للعب واستمر في جمع الذباب!"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր կենդանիները սպասում են:Վերադարձեք խաղալու և շարունակեք ճանճեր հավաքել:"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমাৰ জীৱ-জন্তুবোৰে ৰৈ আছে। খেলিবলৈ উভতি আহক আৰু মাখি সংগ্ৰহ কৰি থাকিব!"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heyvanlarınız gözləyir. Oynamaq üçün qayıdın və milçəklər toplamağa davam edin!"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure animaliak zain daude. Itzuli jolastera eta jarraitu euliak biltzen!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পশুরা অপেক্ষা করছে। খেলতে ফিরে আসুন এবং মাছি সংগ্রহ করতে থাকুন!"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မင်းရဲ့တိရစ္ဆာန်တွေက စောင့်နေတယ်။ပြန်လာကစားပြီး ယင်ကောင်တွေ ဆက်လက်စုဆောင်းလိုက်ပါ။"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše životinje čekaju. Vratite se da igrate i nastavite skupljati muhe!"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Животните ви чакат. Върнете се да играете и продължавайте да събирате мухи!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els teus animals estan esperant. Torna a jugar i segueix recollint mosques!"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的动物正在等待。回来玩并继续收集苍蝇！"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine dyr venter. Kom tilbage for at spille og fortsæt med at samle fluer!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Tiere warten. Kommen Sie zurück zum Spielen und sammeln Sie weiterhin Fliegen!"
          }
        },
        "et" : {
